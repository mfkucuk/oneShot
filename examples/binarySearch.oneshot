# Binary search finds a value in a sorted array by halving the search range each step
LET N = 50
LET ARRAY[N]
FOR (LET I = 0 : I < N : I++) THEN
    ARRAY[I] = I * 3
END

# Returns the index of TARGET, or -1 if it is not in the array
FUNC SEARCH(TARGET) THEN
    LET LOW = 0
    LET HIGH = N - 1
    LET STEPS = 0

    WHILE (LOW <= HIGH) THEN
        STEPS++
        LET MIDDLE = FLOOR((LOW + HIGH) / 2)

        IF (ARRAY[MIDDLE] == TARGET) THEN
            PRINT "FOUND " + TARGET + " AT INDEX " + MIDDLE + " IN " + STEPS + " STEPS"
            RETURN (MIDDLE)
        END

        IF (ARRAY[MIDDLE] < TARGET) THEN
            LOW = MIDDLE + 1
        ELSE
            HIGH = MIDDLE - 1
        END
    END

    PRINT TARGET + " IS NOT IN THE ARRAY (" + STEPS + " STEPS)"
    RETURN (-1)
END

SEARCH(0)
SEARCH(42)
SEARCH(147)
SEARCH(100)
