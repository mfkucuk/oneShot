# Math: a few functions are built in, the rest come from the math and geometry libraries
IMPORT math
IMPORT geometry

# Built in
PRINT "FLOOR(4.7) = " + FLOOR(4.7)
PRINT "CEIL(4.2) = " + CEIL(4.2)
PRINT "INT(-4.7) = " + INT(-4.7)
PRINT "INT OF THE TEXT 42, PLUS 1 = " + (INT("42") + 1)
PRINT "SQRT(144) = " + SQRT(144)
PRINT "17 % 5 = " + 17 % 5
PRINT "A DICE ROLL: " + (FLOOR(RANDOM() * 6) + 1)

# From IMPORT math (lib/math.oneshot)
PRINT "PI = " + PI
PRINT "MIN(3, 8) = " + MIN(3, 8) + ", MAX(3, 8) = " + MAX(3, 8)
PRINT "ABS(-12) = " + ABS(-12) + ", SIGN(-12) = " + SIGN(-12)
PRINT "CLAMP(150, 0, 100) = " + CLAMP(150, 0, 100)
PRINT "ROUND(2.5) = " + ROUND(2.5) + ", ROUND(2.49) = " + ROUND(2.49)
PRINT "LERP(0, 100, 0.25) = " + LERP(0, 100, 0.25)
LET NUMBERS[4]
NUMBERS[0] = 1
NUMBERS[1] = 2
NUMBERS[2] = 3
NUMBERS[3] = 4
PRINT "SUM OF 1, 2, 3, 4 = " + SUM(NUMBERS) + ", LEN = " + LEN(NUMBERS)
PRINT "GCD(84, 36) = " + GCD(84, 36) + ", LCM(4, 6) = " + LCM(4, 6)
PRINT "POW(2, 10) = " + POW(2, 10)
PRINT "FACTORIAL(5) = " + FACTORIAL(5)

# From IMPORT geometry (lib/geometry.oneshot)
PRINT "DISTANCE(0, 0, 3, 4) = " + DISTANCE(0, 0, 3, 4)
PRINT "COLLIDE(0, 0, 10, 10, 5, 5, 10, 10) = " + COLLIDE(0, 0, 10, 10, 5, 5, 10, 10)
PRINT "INSIDE(3, 3, 0, 0, 10, 10) = " + INSIDE(3, 3, 0, 0, 10, 10)
