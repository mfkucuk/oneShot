# A parallax starfield: far stars are dim and slow, near stars are bright and fast.
# Hold the arrow keys to speed up or slow down.
WINDOW 320, 240

LET COUNT = 120
LET X[COUNT]
LET Y[COUNT]
LET DEPTH[COUNT]
FOR (LET I = 0 : I < COUNT : I++) THEN
    X[I] = RANDOM() * 320
    Y[I] = RANDOM() * 240
    DEPTH[I] = 1 + FLOOR(RANDOM() * 3)
END

LET SPEED = 1

WHILE (TRUE) THEN
    IF (INPUT("ARROWRIGHT")) THEN
        SPEED = MIN(SPEED + 0.05, 6)
    END
    IF (INPUT("ARROWLEFT")) THEN
        SPEED = MAX(SPEED - 0.05, 0.2)
    END

    COLOR "BLACK"
    FILL ALL

    FOR (LET I = 0 : I < COUNT : I++) THEN
        X[I] = X[I] - DEPTH[I] * SPEED

        # Stars that leave on the left come back on the right
        IF (X[I] < 0) THEN
            X[I] = X[I] + 320
            Y[I] = RANDOM() * 240
        END

        COLOR "rgb(" + DEPTH[I] * 80 + ", " + DEPTH[I] * 80 + ", " + (DEPTH[I] * 70 + 45) + ")"
        FILL X[I], Y[I], DEPTH[I], DEPTH[I]
    END

    COLOR "WHITE"
    TEXT 8, 230, "SPEED " + FLOOR(SPEED * 10) / 10

    SLEEP 1000 / 60
END
